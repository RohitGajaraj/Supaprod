# .graphifyignore - what the knowledge-graph build skips, and why.
# gitignore syntax, last match wins. graphify already skips node_modules, .venv,
# dist, coverage, __snapshots__ and graphify-out via its own built-in list.

# Raster images. The headless extractor has no vision: it reads every file with
# read_text(errors="replace"), so a PNG arrives as replacement characters. Leaving
# these in cost 184,085 tokens of garbage and put junk nodes in the graph.
# SVG is text (XML), so it stays.
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Ambient audio beds, not speech. Nothing to transcribe.
public/soundscape/

# Tool caches and agent scratch. Churn, no architectural signal.
.claude-flow/
.serena/
.context/
.remember/
graphify-out/

# Generated by the router plugin, never hand-edited. Note: it lives at
# src/routeTree.gen.ts, not src/routes/ as CLAUDE.md claims.
src/routeTree.gen.ts

# macOS case-insensitive-FS duplication artifacts (AGENTS.md section 7). Empty, never real.
src/components 2/
src/integrations 2/

# Multi-MB generated design specimens and an asset-vault page. They yield junk
# nodes; obsidian-v3 is retired history per CLAUDE.md.
design-reference/obsidian-v3/design-reference/*.html
docs/pitch/investor-deck/brand-assets.html
