# Project-Cadence — environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored; NEVER commit secrets.
# See AGENTS.md §10 (cross-tool co-development) for how MCP env wiring works.

# --- Supabase: app runtime (client-safe publishable/anon keys) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: MCP server (consumed by .mcp.json) ---
# Personal access token: https://supabase.com/dashboard/account/tokens
# Server-side only — do NOT expose to the client or commit it.
SUPABASE_ACCESS_TOKEN=
# Project ref = the id in your project URL (e.g. abcdefghijklmnop).
SUPABASE_PROJECT_REF=

# Local-dev AI fallback (KI-06): the cloud injects LOVABLE_API_KEY automatically;
# local dev can instead set a free Google AI Studio key (https://aistudio.google.com
# -> Get API key) to route google/* models directly. Lovable gateway wins if both set.
GEMINI_API_KEY=

# --- AI providers (platform keys — server-side only, never VITE_ prefix) ---
# Cohere embed-v4: embeddings + reranking. 1536 dims (zero migration), 128K token limit,
# EU inference available (eu-west-1). Get key: dashboard.cohere.com → API Keys → New.
# When set, ALL embedding calls route to Cohere instead of the Lovable gateway.
COHERE_API_KEY=

# Fireworks AI: completions (agent loop, chat, Critic). Llama 4 Maverick, $0.15/$0.60/1M.
# 94% cheaper than GPT-4o. Get key: fireworks.ai → API → Create API Key.
# When set, becomes the default completion provider for users without a BYO key.
FIREWORKS_API_KEY=

# Decision Brain supersession engine (DBR-1.5). OFF by default. When set to 1/true, each
# recorded outcome embeds the decision (one cheap embed) and writes typed
# supersedes/contradicts edges into artifact_lineage (bi-temporal, invalidate-don't-delete).
# Leave empty to keep it dormant: zero AI spend, byte-identical recordOutcome.
DECISION_BRAIN_SUPERSESSION=

# --- Observability (AFD initiative — dormant by design) -----------------------
# All three are OPTIONAL. When a key is absent, the matching façade no-ops; user
# flows are never blocked by observability. Even with keys present, traffic is
# additionally gated by the `observability_enabled` app_setting (flip from
# Admin → Observability). See docs/runbooks/observability.md for setup.

# PostHog EU (analytics + session replay + flags). Create the project in the EU
# region (eu.posthog.com) so events stay in-region. Server key starts `phc_`.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# SEN-05: PostHog INBOUND (product analytics → Cadence signals).
# Distinct from the outbound capture key above. Personal API key from
# PostHog → Settings → Personal API Keys (needs "query:read" scope).
# Also set the project ID from your PostHog project URL.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Sentry EU (error capture + performance). DSN from a project hosted on sentry.io
# with EU data residency. Format: https://<key>@<host>/<project-id>.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0

# Better Stack (heartbeats + uptime + on-call + status page). Set this to the
# heartbeat BASE URL (without a trailing slug); withJobRun appends `/<job_name>`
# per cron, so one env var covers every job's heartbeat.
BETTER_STACK_HEARTBEAT_URL=

# ============================================================================
# SW-6 env manifest completion (mission 3.12 "production config truth").
# Everything below is READ by server code (grep-verified 2026-07-07). Server
# vars go in wrangler secrets / the platform env, never with a VITE_ prefix.
# Flags marked [flag] are feature toggles, safe to leave unset (code defaults).
# ============================================================================

# --- Core secrets (server-only) ---
SUPABASE_SERVICE_ROLE_KEY=          # wrangler secret; bypasses RLS, never client-side
CONNECTOR_SECRETS_KEY=              # AES-256-GCM vault key + connect-state HMAC
CRON_SECRET=                        # accepted by /api/public/hooks/* (x-cron-key)
HOOK_CRON_SECRET=                   # alternate hook secret (same guard)
LOVABLE_API_KEY=                    # AI gateway (cloud injects automatically)

# --- Transactional email (Resend) ---
# UNDOCUMENTED UNTIL 2026-08-07, WHICH IS HOW THIS WENT WRONG. The key was put
# into RESEND_FROM_EMAIL and RESEND_API_KEY was left empty, so every send was a
# silent no-op for hours and the key was rendered on an admin page as a "From
# address". Two variables, one of which is a secret and one of which is not:
#
#   RESEND_API_KEY     THE SECRET. Starts `re_`. Sending access is enough; it
#                      does not need full access. Without it sendEmail() no-ops
#                      honestly and returns a reason, which is correct behaviour
#                      and NOT a bug: it means a local dev server can never
#                      accidentally email a real waitlist signup.
#   RESEND_FROM_EMAIL  NOT a secret, and LEAVE IT EMPTY. The code already
#                      defaults to `Supaprod <notifications@supaprod.ai>`, which
#                      is right. Setting it buys nothing and is the field the key
#                      landed in. If you ever do set it, it must contain an `@`.
#
# Production only. Set RESEND_API_KEY in the platform env so it reaches the
# Cloudflare Worker, and remember a secret only takes effect on a deploy that
# happens AFTER it was added. Verify at Admin -> Health, which reports whether
# the key is present in the runtime actually serving requests.
RESEND_API_KEY=
RESEND_FROM_EMAIL=                  # leave empty; the default sender is correct

# Absolute base for links that travel outside the browser (invite mail, digests,
# webhooks). A bare path is not clickable in a mail client. Defaults to
# https://supaprod.ai when unset.
APP_ORIGIN=

# [flag] The public launch date, rendered VERBATIM into the waitlist welcome.
# DELIBERATELY UNSET IN PRODUCTION (founder ruling 2026-08-07): the date is held
# internally and withheld publicly to keep the suspense, so the email promises an
# invite code instead. A test fails the build if a month name leaks while this is
# empty. Free text, not a parsed date, so the wording stays the founder's.
LAUNCH_DATE=

# --- GitHub App (repo connect + ingest) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=                       # fallback PAT for repo reads
GITHUB_REPO=                        # default repo slug for build/ship flows
GITHUB_WEBHOOK_SECRET=               # verifies /api/public/hooks/github-webhook; set the SAME value in the GitHub App's own Webhook secret field

# --- Connector / integration keys (server-only) ---
ASSEMBLYAI_API_KEY=                 # audio transcription
FIRECRAWL_API_KEY=                  # web scraping floor
LINEAR_API_KEY=
NOTION_API_KEY=
GOOGLE_CALENDAR_API_KEY=
GOOGLE_DOCS_API_KEY=
GOOGLE_APP_USER_CONNECTOR_CLIENT_ID=
MICROSOFT_APP_USER_CONNECTOR_CLIENT_ID=
SALESFORCE_INSTANCE_URL=
SLACK_SIGNAL_CHANNEL=
SLACK_CLIENT_ID=                    # SW-7 native OAuth Connect button — from Slack app's Basic Information -> App Credentials
SLACK_CLIENT_SECRET=                # same page; also add the Cadence redirect URL under OAuth & Permissions -> Redirect URLs
ZENDESK_EMAIL=
ZENDESK_SUBDOMAIN=
SEARXNG_URL=                        # self-hosted search for research mode
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# --- Payments (dormant credit engine; founder-gated) ---
STRIPE_LIVE_API_KEY=
STRIPE_SANDBOX_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
VITE_PAYMENTS_CLIENT_TOKEN=         # client-safe payments token (VITE_ ok)

# --- Build/ship drivers (BD seam) ---
OPENHANDS_API_KEY=
OPENHANDS_ENDPOINT=
OPENHANDS_LLM_API_KEY=
OPENHANDS_LLM_BASE_URL=
OPENHANDS_LLM_MODEL=
DENO_DEPLOY_ACCESS_TOKEN=
DENO_DEPLOY_TOKEN=
CLOUDFLARE_DEPLOY_HOOK_URL=
LOVABLE_DEPLOY_HOOK_URL=
DELEGATE_OUTBOUND_ENABLED=          # [flag] outbound delegate calls

# --- Feature flags / tuning ([flag], code defaults apply when unset) ---
AGENT_FANOUT=
AGENT_NATIVE_TOOLCALLING=
AI_CAPABILITY_ROUTING=
AI_COST_ROUTING=
AI_PROVIDER_FALLBACK=
BRAIN_AUTO_TRIGGER=
DBR_ENTITY_ALIASING=
DECISION_BRAIN_SUPERSESSION=
DEFAULT_AGENT_MODEL=
EVAL_COVERAGE_FLOOR_PCT=
EVAL_COVERAGE_REQUIRED_SURFACES=
HANDOFF_EVIDENCE_GATE=
MISSION_ADVANCE_BATCH=
MISSION_STEP_DISPATCH_CAP=
ONBOARDING_SEED_ENABLED=            # [flag] demo-data button on onboarding connect step
SAMPLE_WORKSPACE_ENABLED=           # [flag] sample-workspace seeding
STUDIO_AUTO_SHIP=                   # [flag] trust-graduated auto-ship

# --- Runtime-injected (do NOT set manually; documented for completeness) ---
# CF_VERSION_METADATA_ID            # Cloudflare deploy id; surfaces as health.release

# --- Lenny's Data paid archive (research corpus, NOT a product dependency) ---
LENNYSDATA_TOKEN=                   # MCP bearer for mcp.lennysdata.com; personal, ~30d expiry, reissue at lennysdata.com. See docs/research/lennys-data-archive.md

# ── SIGNING IN TO DRIVE THE PRODUCT ──────────────────────────────────────────
# There is a demo account and it is NOT in this file. Three lanes (S1, S3, S4)
# each looked here, found nothing, and reported themselves blocked on the
# founder before anyone read the README line that names it.
#
#   docs/operations/demo-credentials.md   <- the ONLY copy of every password
#   README.md:437                          <- what points at it
#
# Use `harbor@supaprod.ai`. That file calls it "the account any agent uses for
# testing": it is the rehearsal copy, disposable, and deliberately never sent to
# anyone outside. NEVER rehearse on an investor login (voyage@, compass@,
# lantern@, explore@) — approving a gate is a write, and it hands that firm an
# already-empty approval queue, which is the beat the demo is built around.
#
# Passwords are NOT repeated here on purpose: that file carries a warning that
# rows go stale when somebody rotates without updating it, and a second copy is
# a second thing to go stale. Read it there.
#
# E2E_DEMO_EMAIL / E2E_DEMO_PASSWORD in your own gitignored .env are what
# Playwright and a browser check read.
